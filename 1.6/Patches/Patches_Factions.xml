          <Petrikin>0.15</Petrikin>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Trooper" or defName="Empire_Fighter_Janissary" or defName="Empire_Fighter_Cataphract"]/xenotypeSet/xenotypeChances</xpath>
    <value>
      <Petrikin>0.15</Petrikin>
    </value>
  </Operation>
</Patch>
