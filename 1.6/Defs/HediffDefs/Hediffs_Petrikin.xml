<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>Petrikin_SpikedTailHediff</defName>
    <label>spiked tail</label>
    <description>A reptilian tail with sharp spikes used in close combat.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.8, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>tail spike</label>
            <capacities>
              <li>Stab</li>
            </capacities>
            <power>12</power>
            <cooldownTime>2.0</cooldownTime>
            <armorPenetration>0.25</armorPenetration>
            <chanceFactor>0.3</chanceFactor>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Petrikin_FlashgazeHediff</defName>
    <label>flash-calcified</label>
    <description>A temporary stiffening of the joints and calcification of the skin from a sudden optical flash. Movement and manipulation are heavily slowed down, but will wear off over time.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.6, 0.6)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.75</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
        <totalBleedFactor>0.25</totalBleedFactor>
      </li>
    </stages>
  </HediffDef>
</Defs>
